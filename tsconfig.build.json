{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "src/index.ts",
    "src/components/**/*",
    "src/components/**/*.vue",
    "src/composables/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": [
    "src/__tests__/**/*",
    "src/**/__tests__/**/*",
    "src/stories/**/*"
  ],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
  }
}

